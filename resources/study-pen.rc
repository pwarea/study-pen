#include "study-pen-version.h"

101 ICON "resources/study-pen.ico"

1 VERSIONINFO
 FILEVERSION STUDY_PEN_VERSION_NUM
 PRODUCTVERSION STUDY_PEN_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Study Pen"
            VALUE "FileVersion", STUDY_PEN_VERSION_TEXT
            VALUE "InternalName", "study-pen"
            VALUE "OriginalFilename", "study-pen.exe"
            VALUE "ProductName", "Study Pen"
            VALUE "ProductVersion", STUDY_PEN_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
